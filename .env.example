# Copy to .env and fill in. Never commit .env.

# Postgres (docker-compose.yml)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=change-me

# Phoenix image tag (optional override)
# PHOENIX_VERSION=version-20.9.0

# Used from Phase 2 onward. Set a monthly spend limit on this key in the Anthropic Console.
ANTHROPIC_API_KEY=

# Used once we connect to real data (end of Phase 2).
# SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
# SHOPIFY_ADMIN_TOKEN=
# ZENDESK_SUBDOMAIN=
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=
