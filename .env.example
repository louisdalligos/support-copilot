# Copy to .env and fill in. Never commit .env.

# Postgres (docker-compose.yml)
POSTGRES_USER=copilot
POSTGRES_PASSWORD=change-me

# Tracing: where Phoenix receives traces (default shown), and a switch to turn tracing off.
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
# COPILOT_TRACING=off

# Phoenix image tag (optional override)
# PHOENIX_VERSION=version-20.9.0

# Used from Phase 2 onward. Set a monthly spend limit on this key in the Anthropic Console.
ANTHROPIC_API_KEY=
# Key for redaction tokens in logs, traces and reports. Set a long random value outside local dev.
# COPILOT_REDACTION_KEY=

# Optional: the approval app uses the Postgres above by default; set this to use another database.
# COPILOT_DATABASE_URL=postgresql://copilot:change-me@127.0.0.1:5432/copilot
# Optional: the name pre-filled as reviewer in the approval app.
# COPILOT_REVIEWER=Louis

# Optional: which Claude models the agent uses (defaults shown).
# COPILOT_TRIAGE_MODEL=claude-haiku-5-5
# COPILOT_DRAFT_MODEL=claude-sonnet-5-5

# A real Shopify development store instead of the seed data (docs/shopify.md).
# COPILOT_SHOPIFY=live
# SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=

# A real Zendesk account instead of the seed tickets (docs/zendesk.md).
# COPILOT_ZENDESK=live
# ZENDESK_SUBDOMAIN=your-subdomain
# ZENDESK_EMAIL=
# ZENDESK_API_TOKEN=
# The webhook's signing secret; turns on POST /webhooks/zendesk.
# ZENDESK_WEBHOOK_SECRET=
